<nav class="breadcrumbs" aria-label="Breadcrumb">
  {%- set crumbs = page.url | breadcrumbs(collections.contentPages) -%}
  {% for c in crumbs %}
    {% if loop.last %}
      <span class="breadcrumbs__current" aria-current="page">{{ title or c.label }}</span>
    {% else %}
      <a href="{{ site.url }}{{ c.url }}">{{ c.label }}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    {% endif %}
  {% endfor %}
</nav>
