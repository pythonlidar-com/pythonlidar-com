<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand" href="/" aria-label="{{ site.name }} — home">
        {% include "partials/logo-inline.njk" %}
        <span class="brand__text">{{ site.shortName }}</span>
      </a>
      <p>{{ site.description }}</p>
    </div>

    {% for section in site.sections %}
      {% set topicsHere = collections.topics | childrenOf("/" + section.slug + "/") %}
      <div>
        <h2>{{ section.label }}</h2>
        <ul>
          <li><a href="/{{ section.slug }}/">Overview</a></li>
          {% for t in topicsHere %}
            <li><a href="{{ t.url }}">{{ t.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
  <div class="container site-footer__meta">
    <span>© {{ site.name }}</span>
    <span class="site-footer__meta-end">
      <span>Built with 11ty · Optimized for offline use</span>
      <a class="site-footer__icon-link" href="https://github.com/pythonlidar-com/" target="_blank" rel="noopener" aria-label="Python LiDAR on GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2.01-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 5.74 0c2.18-1.48 3.14-1.17 3.14-1.17.63 1.58.23 2.75.12 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.7 5.36-5.27 5.65.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12c0-6.35-5.15-11.5-11.5-11.5z"/></svg>
      </a>
    </span>
  </div>
</footer>
