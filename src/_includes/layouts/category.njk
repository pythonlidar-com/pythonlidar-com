---
layout: layouts/base.njk
---
<div class="container page">
  <div class="layout-grid">
    <div>
      {% include "partials/breadcrumbs.njk" %}
      <article class="article">
        <h1>{{ title }}</h1>
        {{ content | stripH1 | safe }}

        {%- set topics = collections.topics | childrenOf(page.url) -%}
        {% if topics and topics.length %}
        <section class="related">
          <h2>Topics in this section</h2>
          <div class="related__grid">
            {% for t in topics %}
              <a class="related__card" href="{{ t.url }}">
                <span class="related__card-title">{{ t.data.title }}</span>
                <span class="related__card-blurb">{{ t.data.metaDescription | truncate(140) }}</span>
              </a>
            {% endfor %}
          </div>
        </section>
        {% endif %}
      </article>
    </div>

    <aside class="side-rail" aria-label="In this section">
      <h3>In this section</h3>
      <ul>
        <li><a href="{{ page.url }}" aria-current="page">Overview</a></li>
        {% for t in topics %}
          <li><a href="{{ t.url }}">{{ t.data.title }}</a></li>
        {% endfor %}
      </ul>
    </aside>
  </div>
</div>
